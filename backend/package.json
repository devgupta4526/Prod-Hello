{
  "name": "hello-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "scripts": {
    "dev": "node --env-file=.env --import tsx --watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:deploy": "node --env-file=.env node_modules/prisma/build/index.js migrate deploy",
    "seed": "node --env-file=.env --import tsx src/seed.ts",
    "openapi": "tsx src/export-openapi.ts",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@fastify/cors": "11.3.1",
    "@fastify/helmet": "13.2.0",
    "@fastify/swagger": "9.9.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "cloudinary": "2.11.0",
    "fastify": "5.12.7",
    "fastify-type-provider-zod": "7.0.0",
    "jose": "6.2.12",
    "libphonenumber-js": "1.13.15",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "twilio": "6.2.0",
    "uuid": "14.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testcontainers/postgresql": "12.2.1",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  }
}
