# Copy to .env; generate separate random secrets of at least 32 bytes.
APP_ENV=local
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://hello:hello_local_only@localhost:5432/hello
DIRECT_URL=postgresql://hello:hello_local_only@localhost:5432/hello
JWT_ACCESS_SECRET=
JWT_REFRESH_PEPPER=
OTP_HASH_PEPPER=
OTP_PROVIDER=console
OTP_SANDBOX_NUMBERS=
OTP_DAILY_SMS_BUDGET=0
OTP_ALLOWED_COUNTRIES=IN
MIN_APP_VERSION=1
MAINTENANCE_MODE=false
# Optional integrations: fill all credentials for any selected real provider.
# OTP_FALLBACK_PROVIDER=twilio
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
# TWILIO_STATUS_CALLBACK_URL=https://YOUR-API/v1/webhooks/sms/twilio
# SMS_APP_HASH=
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
ADMIN_ORIGIN=http://localhost:5173
