<com.example.romear.core.designsystem.HelloCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/card_gutter"
    android:layout_marginVertical="8dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/hello_outline_subtle"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingVertical="18dp">

        <!-- Top Badges Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/ticketTierBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_emerald"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="@color/hello_emerald"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="GENERAL ADMISSION" />

            <TextView
                android:id="@+id/ticketStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_badge_pill"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:textColor="@color/hello_text_secondary"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="CONFIRMED" />
        </LinearLayout>

        <!-- Event Title -->
        <TextView
            android:id="@+id/ticketEventTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/hello_text"
            android:textSize="19sp"
            android:textStyle="bold"
            tools:text="Delhi Indie Sunset Sessions" />

        <!-- Venue & Date -->
        <TextView
            android:id="@+id/ticketVenueDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/hello_text_secondary"
            android:textSize="13sp"
            tools:text="🗓️ Oct 22, 2026 · The Rooftop at Connaught Place" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:background="@color/hello_outline_subtle" />

        <!-- Ticket Action Footer -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Tap to show ticket pass"
                android:textColor="@color/hello_text_tertiary"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/viewQrButton"
                style="@style/Widget.Hello.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_target"
                android:paddingHorizontal="16dp"
                android:paddingVertical="0dp"
                android:text="@string/ticket_qr_title"
                android:textSize="13sp"
                app:cornerRadius="999dp"
                app:icon="@drawable/ic_qr"
                app:iconGravity="textStart"
                app:iconPadding="6dp"
                app:iconSize="18dp" />
        </LinearLayout>
    </LinearLayout>
</com.example.romear.core.designsystem.HelloCardView>
