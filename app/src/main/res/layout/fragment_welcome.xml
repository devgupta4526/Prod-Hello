<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@drawable/bg_hello_header">
  <com.example.romear.core.designsystem.ReadableColumnLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/screen_gutter" android:layout_gravity="center_horizontal">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/wordmark" android:textAppearance="@style/TextAppearance.Hello.Title" android:textColor="@color/hello_primary" />
    <ImageView android:layout_width="match_parent" android:layout_height="@dimen/illustration_height" android:layout_marginTop="@dimen/space_lg" android:src="@drawable/illustration_people" android:importantForAccessibility="no" android:scaleType="fitCenter" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_xl" android:text="@string/welcome_eyebrow" android:textAppearance="@style/TextAppearance.Hello.Eyebrow" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_md" android:text="@string/welcome_title" android:textAppearance="@style/TextAppearance.Hello.Hero" android:accessibilityHeading="true" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_md" android:text="@string/welcome_body" android:textAppearance="@style/TextAppearance.Hello.Body" />
