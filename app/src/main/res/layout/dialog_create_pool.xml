<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet_rounded">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="12dp"
        android:paddingBottom="28dp">

        <!-- Sheet Drag Handle -->
        <View
            android:layout_width="44dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_bottom_sheet_handle" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WHAT'S THE PLAN?"
            android:textAppearance="@style/TextAppearance.Hello.Eyebrow" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Host a Hangout"
            android:textAppearance="@style/TextAppearance.Hello.ScreenTitle" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Spontaneous gatherings with verified people in your neighborhood."
            android:textAppearance="@style/TextAppearance.Hello.Caption" />

        <!-- Title Input -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Hello.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:hint="@string/pool_title_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/poolTitleInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences"
                android:maxLength="80"
                android:textColor="@color/white" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Activity Input -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Hello.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/pool_activity_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/poolActivityInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapWords"
                android:maxLength="40"
                android:textColor="@color/white" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Capacity Input -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Hello.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/pool_capacity_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/poolCapacityInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:textColor="@color/white" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- When & Where Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="WHEN &amp; WHERE"
            android:textAppearance="@style/TextAppearance.Hello.Eyebrow" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/poolDateButton"
            style="@style/Widget.Hello.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="Choose date and time"
            app:cornerRadius="999dp"
            app:icon="@drawable/ic_calendar"
            app:iconGravity="textStart"
            app:iconPadding="10dp"
            app:iconTint="@color/primary_coral" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:labelFor="@id/poolDuration"
            android:text="Duration"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/poolDuration"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_phone_input_card"
            android:paddingHorizontal="14dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/poolLocationButton"
            style="@style/Widget.Hello.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:minHeight="48dp"
            android:text="Use my nearby location"
            app:cornerRadius="999dp"
            app:icon="@drawable/ic_location"
            app:iconGravity="textStart"
            app:iconPadding="10dp"
            app:iconTint="@color/primary_coral" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingExtra="3dp"
            android:text="Your approximate radius helps nearby people find this hangout. Specific meeting spot is coordinated in the group chat once approved."
            android:textAppearance="@style/TextAppearance.Hello.Caption" />

        <!-- Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/cancelCreatePoolButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/cancel"
                android:textColor="@color/text_tertiary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/submitCreatePoolButton"
                style="@style/Widget.Hello.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:background="@drawable/bg_gradient_primary"
                app:backgroundTint="@null"
                android:text="Publish Hangout ⚡"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                app:cornerRadius="999dp" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
