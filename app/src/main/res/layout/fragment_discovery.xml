<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hello_background">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/hello_background"
        android:elevation="0dp"
        android:stateListAnimator="@null">

        <LinearLayout
            android:id="@+id/headerContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/bg_canvas"
            android:elevation="0dp"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_gutter"
            android:paddingTop="20dp"
            android:paddingBottom="12dp"
            app:layout_scrollFlags="scroll|enterAlways">

            <!-- Top Header Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/headerEyebrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/discovery_section"
                        android:textAppearance="@style/TextAppearance.Hello.Eyebrow" />

                    <TextView
                        android:id="@+id/headerTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:accessibilityHeading="true"
                        android:text="@string/discovery_heading"
                        android:textAppearance="@style/TextAppearance.Hello.ScreenTitle" />
                </LinearLayout>

                <!-- Top Action Buttons: Hotspots & Filters -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Filter Preferences Button -->
                    <ImageView
                        android:id="@+id/filterIcon"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_circle_icon_button"
                        android:contentDescription="Discovery Filters"
                        android:padding="9dp"
                        android:src="@drawable/ic_tune"
                        app:tint="@color/text_primary" />

                    <!-- Live Radar Hotspots Icon -->
                    <ImageView
                        android:id="@+id/radarIcon"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_badge_peach"
                        android:contentDescription="Radar Hotspots"
                        android:padding="9dp"
                        android:src="@drawable/ic_discover"
                        app:tint="@color/hello_primary" />
                </LinearLayout>
            </LinearLayout>

            <!-- "Right Now" / Live Status Stories Bar (Instagram Notes Style) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/liveStatusRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:overScrollMode="never"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:itemCount="5"
                tools:listitem="@layout/item_live_status_note" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/vibeCheckBanner"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/bg_surface_1" app:cardCornerRadius="22dp"
                app:cardElevation="0dp" app:strokeColor="@color/accent_lavender" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">
                    <TextView android:id="@+id/vibeCheckTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="⚡ DAILY ICEBREAKER · 7 PM" android:textAppearance="@style/TextAppearance.Hello.Eyebrow" />
                    <TextView android:id="@+id/vibeCheckQuestion" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" android:text="Best late-night food spot in the city?"
                        android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
                        android:text="Answer →" android:textAppearance="@style/TextAppearance.Hello.Body" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.button.MaterialButton android:id="@+id/upForButton" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <com.google.android.material.button.MaterialButton android:id="@+id/homeButton" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />            <!-- Availability & Ghost Mode Filter Chips -->
            <HorizontalScrollView
                android:id="@+id/availabilityScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:clipToPadding="false"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/availabilityGroup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:chipSpacingHorizontal="8dp"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipOpen"
                        style="@style/Widget.Hello.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="● Open to meet"
                        app:chipCornerRadius="18dp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipBrowsing"
                        style="@style/Widget.Hello.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Browsing"
                        app:chipCornerRadius="18dp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipInvisible"
                        style="@style/Widget.Hello.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ghost Mode"
                        app:chipCornerRadius="18dp" />
                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <ProgressBar
            android:id="@+id/loadingIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="@color/hello_primary"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/usersRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="8dp"
            android:paddingBottom="24dp" />

        <androidx.core.widget.NestedScrollView
            android:id="@+id/emptyStateView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="32dp">

                <ImageView
                    android:layout_width="140dp"
                    android:layout_height="140dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/illustration_radar" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="No one nearby right now"
                    android:textColor="@color/white"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp"
                    android:text="People open to saying hello will appear here as they come online in your area."
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <!-- Action Buttons: Screen 2.8 -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnExpandRadius"
                    style="@style/Widget.Hello.Button.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/bg_gradient_primary"
                    app:backgroundTint="@null"
                    android:paddingHorizontal="24dp"
                    android:text="Expand Radius to 10 km"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:cornerRadius="999dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnShareFriends"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginTop="8dp"
                    android:text="Share Romear with Friends"
                    android:textColor="@color/primary_coral"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <LinearLayout
            android:id="@+id/discoveryError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@color/hello_surface"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite"
                android:gravity="center"
                android:text="@string/discovery_load_error"
                android:textAppearance="@style/TextAppearance.Hello.Body" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/discoveryRetry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/discovery_retry" />
        </LinearLayout>
    </FrameLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>