<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet_rounded"
    android:orientation="vertical"
    android:paddingBottom="28dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="44dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_bottom_sheet_handle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="REFUND TRACKER"
            android:textAppearance="@style/TextAppearance.Hello.Eyebrow" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Refund in Progress"
            android:textAppearance="@style/TextAppearance.Hello.ScreenTitle" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Your booking has been cancelled and reversal initiated."
            android:textAppearance="@style/TextAppearance.Hello.Caption" />

        <!-- Refund Card -->
        <com.example.romear.core.designsystem.HelloCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/refundAmountLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="₹499 to original payment method"
                    android:textAppearance="@style/TextAppearance.Hello.CardHeadline" />

                <TextView
                    android:id="@+id/refundReference"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="REFUND REFERENCE: RF-1024"
                    android:textAppearance="@style/TextAppearance.Hello.Eyebrow"
                    android:textColor="@color/hello_coral" />
            </LinearLayout>
        </com.example.romear.core.designsystem.HelloCardView>

        <!-- Timeline -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="STATUS TIMELINE"
            android:textAppearance="@style/TextAppearance.Hello.Eyebrow" />

        <!-- Step 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_circle_surface"
                android:gravity="center"
                android:text="✓"
                android:textColor="@color/hello_emerald"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cancellation Confirmed"
                    android:textAppearance="@style/TextAppearance.Hello.BodyBold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Just now · Pass released"
                    android:textAppearance="@style/TextAppearance.Hello.Micro" />
            </LinearLayout>
        </LinearLayout>

        <!-- Step 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_circle_surface"
                android:gravity="center"
                android:text="⚡"
                android:textColor="@color/hello_amber" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Refund Requested"
                    android:textAppearance="@style/TextAppearance.Hello.BodyBold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Payment provider is processing the reversal"
                    android:textAppearance="@style/TextAppearance.Hello.Micro" />
            </LinearLayout>
        </LinearLayout>

        <!-- Step 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_circle_surface"
                android:gravity="center"
                android:text="○"
                android:textColor="@color/hello_text_tertiary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Refund Completed"
                    android:textAppearance="@style/TextAppearance.Hello.Body"
                    android:textColor="@color/hello_text_secondary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Expected in 2–4 business days back to original source"
                    android:textAppearance="@style/TextAppearance.Hello.Micro" />
            </LinearLayout>
        </LinearLayout>

        <!-- Dismiss button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDoneRefund"
            style="@style/Widget.Hello.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_gradient_primary"
            app:backgroundTint="@null"
            android:text="Back to Passes"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="999dp" />
    </LinearLayout>
</LinearLayout>
