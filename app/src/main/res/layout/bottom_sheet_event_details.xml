<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_sheet_rounded">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="100dp"
        android:overScrollMode="ifContentScrolls">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Hero Banner -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="180dp">

                <ImageView
                    android:id="@+id/eventArtworkHero"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/hello_surface_variant"
                    android:scaleType="centerCrop"
                    android:contentDescription="@null" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_gradient_scrim" />

                <!-- Sheet Handle -->
                <View
                    android:layout_width="44dp"
                    android:layout_height="4dp"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_bottom_sheet_handle" />

                <!-- Category & Title Overlay -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:orientation="vertical"
                    android:paddingHorizontal="20dp"
                    android:paddingBottom="16dp">

                    <TextView
                        android:id="@+id/eventCategory"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_lilac"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="5dp"
                        android:textColor="@color/hello_indigo_text"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:text="LIVE MUSIC" />

                    <TextView
                        android:id="@+id/eventDetailTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/white"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        tools:text="Sunset Acoustics &amp; Vinyl Sessions" />
                </LinearLayout>
            </FrameLayout>

            <!-- Event Body -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="16dp">

                <!-- Venue & Time Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/hello_surface_container"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/hello_outline_subtle"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/eventDetailTimeVenue"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:lineSpacingExtra="3dp"
                            android:textColor="@color/hello_text_secondary"
                            android:textSize="14sp"
                            tools:text="Sat, 26 Oct · 6:30 PM\nThe Loft Cafe · Indiranagar" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Description -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="ABOUT THIS EVENT"
                    android:textAppearance="@style/TextAppearance.Hello.Eyebrow" />

                <TextView
                    android:id="@+id/eventDetailDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/hello_text"
                    android:textSize="15sp"
                    tools:text="An intimate evening of live acoustic indie sets, specialty craft brew tastings, and local artists." />

                <!-- Tiers -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/event_tier_select"
                    android:textAppearance="@style/TextAppearance.Hello.Eyebrow" />

                <RadioGroup
                    android:id="@+id/tierRadioGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />

                <!-- Quantity Stepper -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/event_quantity"
                    android:textAppearance="@style/TextAppearance.Hello.Eyebrow" />

                <com.example.romear.core.designsystem.QuantityStepper
                    android:id="@+id/quantityStepper"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />

            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Sticky Booking Action Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_sheet_rounded"
        android:elevation="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Total"
                android:textColor="@color/hello_text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/totalPriceLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/hello_primary"
                android:textSize="20sp"
                android:textStyle="bold"
                tools:text="₹499" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/confirmBookingButton"
            style="@style/Widget.Hello.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:minWidth="160dp"
            android:text="@string/event_book"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="26dp"
            app:icon="@drawable/ic_tickets"
            app:iconGravity="textStart"
            app:iconPadding="8dp" />
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
