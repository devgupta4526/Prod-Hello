<com.example.romear.core.designsystem.HelloCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/card_gutter"
    android:layout_marginVertical="8dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/hello_outline_subtle"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <com.example.romear.core.designsystem.AvatarView
            android:id="@+id/avatar"
            android:layout_width="52dp"
            android:layout_height="52dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/userName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:textColor="@color/hello_text"
            android:textSize="17sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/avatar"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Aarav Sharma" />

        <TextView
            android:id="@+id/statusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_badge_peach"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:textColor="@color/hello_primary"
            android:textSize="11sp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@id/avatar"
            app:layout_constraintTop_toBottomOf="@id/userName"
            tools:text="Wants to connect" />

        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/identityBottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="avatar,statusBadge" />

        <!-- Conversational Message Bubble -->
        <TextView
            android:id="@+id/helloMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_badge_pill"
            android:lineSpacingExtra="3dp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="14dp"
            android:textColor="@color/hello_text"
            android:textSize="15sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/identityBottom"
            tools:text="Hey! Saw that you love indie music too. Would love to grab coffee sometime." />

        <!-- Actions Container -->
        <LinearLayout
            android:id="@+id/actionsContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/helloMessage">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/declineButton"
                style="@style/Widget.Hello.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:minHeight="@dimen/touch_target"
                android:paddingHorizontal="12dp"
                android:paddingVertical="0dp"
                android:text="@string/inbox_decline"
                android:textColor="@color/hello_text_secondary"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/acceptButton"
                style="@style/Widget.Material3.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:minHeight="@dimen/touch_target"
                android:backgroundTint="@color/hello_primary"
                android:letterSpacing="0"
                android:paddingHorizontal="16dp"
                android:paddingVertical="0dp"
                android:text="@string/inbox_accept"
                android:textColor="@color/hello_on_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="22dp"
                app:icon="@drawable/ic_check"
                app:iconGravity="textStart"
                app:iconPadding="6dp"
                app:iconSize="16dp"
                app:iconTint="@color/hello_on_primary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/withdrawButton"
                style="@style/Widget.Hello.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_target"
                android:paddingHorizontal="14dp"
                android:paddingVertical="0dp"
                android:text="@string/inbox_withdraw"
                android:textColor="@color/hello_text_secondary"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.example.romear.core.designsystem.HelloCardView>