<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet_rounded"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="28dp">

    <!-- Celebration Badge -->
    <TextView
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:background="@drawable/bg_badge_lilac"
        android:gravity="center"
        android:text="🎉"
        android:textSize="36sp" />

    <TextView
        android:id="@+id/celebrationTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="It's a Hello! 🎉"
        android:textColor="@color/white"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/celebrationSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:text="You are now connected. Conversations spark when you say hello back within 24h."
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />

    <!-- Open Chat CTA -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCelebrationChat"
        style="@style/Widget.Hello.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_gradient_primary"
        app:backgroundTint="@null"
        android:text="Send a Message 👋"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="bold"
        app:cornerRadius="999dp" />

    <!-- Dismiss / Keep Browsing -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnKeepBrowsing"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:text="Keep Browsing"
        android:textColor="@color/text_tertiary"
        android:textSize="14sp" />
</LinearLayout>
