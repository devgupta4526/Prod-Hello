<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet_rounded"
    android:orientation="vertical"
    android:paddingBottom="28dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="44dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_bottom_sheet_handle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HELP &amp; SUPPORT"
            android:textAppearance="@style/TextAppearance.Hello.Eyebrow" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="We’re Here to Help"
            android:textAppearance="@style/TextAppearance.Hello.ScreenTitle" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Submit an issue regarding your booking, ticket, or venue."
            android:textAppearance="@style/TextAppearance.Hello.Caption" />

        <!-- Selected Booking -->
        <com.example.romear.core.designsystem.HelloCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/supportBookingTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Founders &amp; Creatives Mixer"
                    android:textAppearance="@style/TextAppearance.Hello.CardHeadline" />

                <TextView
                    android:id="@+id/supportBookingRef"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="BOOKING RM-1024 · ₹499"
                    android:textAppearance="@style/TextAppearance.Hello.Eyebrow" />
            </LinearLayout>
        </com.example.romear.core.designsystem.HelloCardView>

        <!-- Issue Category -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="ISSUE CATEGORY"
            android:textAppearance="@style/TextAppearance.Hello.Eyebrow" />

        <RadioGroup
            android:id="@+id/supportCategoryGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp">

            <RadioButton
                android:id="@+id/radioIssuePayment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:paddingVertical="4dp"
                android:text="Payment or refund issue"
                android:textColor="@color/hello_text"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/radioIssueVenue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="4dp"
                android:text="Venue access or arrival instructions"
                android:textColor="@color/hello_text"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/radioIssueQr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="4dp"
                android:text="QR code or ticket check-in"
                android:textColor="@color/hello_text"
                android:textSize="14sp" />
        </RadioGroup>

        <!-- Details Input -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="WHAT HAPPENED?"
            android:textAppearance="@style/TextAppearance.Hello.Eyebrow" />

        <EditText
            android:id="@+id/inputSupportDetails"
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_input_field"
            android:gravity="top|start"
            android:hint="Describe the issue and include any useful details…"
            android:padding="12dp"
            android:textColor="@color/hello_text"
            android:textColorHint="@color/hello_text_tertiary"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="🛡️ Never include passwords, OTPs, or full payment card numbers."
            android:textAppearance="@style/TextAppearance.Hello.Micro" />

        <!-- Send Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSubmitSupport"
            style="@style/Widget.Hello.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_gradient_primary"
            app:backgroundTint="@null"
            android:text="Send Support Request 🚀"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="999dp" />
    </LinearLayout>
</LinearLayout>
