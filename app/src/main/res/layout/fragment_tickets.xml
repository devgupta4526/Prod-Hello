<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/hello_background">
  <com.google.android.material.appbar.AppBarLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/hello_background" android:elevation="0dp" android:stateListAnimator="@null">
    <LinearLayout android:id="@+id/headerContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/bg_canvas" android:elevation="0dp" android:orientation="vertical" android:paddingHorizontal="@dimen/screen_gutter" android:paddingTop="28dp" android:paddingBottom="12dp" app:layout_scrollFlags="scroll|enterAlways">
      <TextView android:id="@+id/headerEyebrow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TICKETS &amp; LOCAL EXPERIENCES" android:textAppearance="@style/TextAppearance.Hello.Eyebrow" />
      <TextView android:id="@+id/headerTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="Make a night of it." android:textAppearance="@style/TextAppearance.Hello.ScreenTitle" android:accessibilityHeading="true" />
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:visibility="gone" android:text="@string/ui_tickets_body" android:textAppearance="@style/TextAppearance.Hello.Caption" android:lineSpacingExtra="3dp" />
      <com.google.android.material.chip.ChipGroup android:id="@+id/ticketsTabGroup" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" app:chipSpacingHorizontal="8dp" app:singleSelection="true" app:selectionRequired="true">
        <com.google.android.material.chip.Chip android:id="@+id/tabExplore" style="@style/Widget.Hello.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" android:text="Upcoming Events" android:textSize="12sp" app:chipCornerRadius="999dp" />
        <com.google.android.material.chip.Chip android:id="@+id/tabMyTickets" style="@style/Widget.Hello.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="My Tickets" android:textSize="12sp" app:chipCornerRadius="999dp" />
      </com.google.android.material.chip.ChipGroup>
      <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:scrollbars="none">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
          <com.google.android.material.chip.Chip android:id="@+id/chipActivityTimeline" style="@style/Widget.Hello.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⚡ Activity &amp; Updates" android:textSize="11sp" android:layout_marginEnd="6dp" />
          <com.google.android.material.chip.Chip android:id="@+id/chipHostingQuotes" style="@style/Widget.Hello.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📑 Venue Quotes" android:textSize="11sp" android:layout_marginEnd="6dp" />
          <com.google.android.material.chip.Chip android:id="@+id/chipVenueCalendar" style="@style/Widget.Hello.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🗓️ Venue Calendar" android:textSize="11sp" />
        </LinearLayout>
      </HorizontalScrollView>
      <com.google.android.material.button.MaterialButton android:id="@+id/searchEvents" style="@style/Widget.Hello.Button.Tonal" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="12dp" android:text="Search events, venues or interests" android:textColor="@color/text_secondary" app:cornerRadius="999dp" app:icon="@drawable/ic_search" app:iconGravity="textStart" app:iconPadding="10dp" app:iconTint="@color/text_secondary" />
      <com.google.android.material.textfield.TextInputLayout android:id="@+id/eventSearchLayout" style="@style/Widget.Hello.TextInputLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="Search events, venues or interests" android:visibility="gone">
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/eventSearchInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text" android:imeOptions="actionSearch" android:maxLines="1" />
      </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>
  </com.google.android.material.appbar.AppBarLayout>
  <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent" app:layout_behavior="@string/appbar_scrolling_view_behavior">
    <ProgressBar android:id="@+id/loadingIndicator" android:layout_width="wrap_content" android:layout_height="wrap_content" android:indeterminateTint="@color/hello_primary" android:visibility="gone" android:layout_gravity="center" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/ticketsRecyclerView" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:paddingTop="8dp" android:paddingBottom="24dp" />
    <androidx.core.widget.NestedScrollView android:id="@+id/emptyStateView" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:visibility="gone">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical" android:padding="32dp">
        <ImageView android:importantForAccessibility="no" android:layout_width="112dp" android:layout_height="112dp" android:background="@drawable/bg_empty_orbit" android:padding="34dp" android:src="@drawable/ic_tickets" app:tint="@color/hello_primary" />
        <TextView android:id="@+id/emptyStateTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="No events found" android:textColor="@color/hello_text" android:textSize="22sp" android:textStyle="bold" />
        <TextView android:id="@+id/emptyStateBody" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:lineSpacingExtra="3dp" android:text="@string/ui_events_empty_body" android:textColor="@color/hello_text_secondary" android:textSize="14sp" />
      </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout android:id="@+id/feedError" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp" android:gravity="center" android:background="@color/hello_surface" android:visibility="gone" android:layout_gravity="bottom">
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_feed_error" android:textAppearance="@style/TextAppearance.Hello.Body" android:gravity="center" android:accessibilityLiveRegion="polite" />
      <com.google.android.material.button.MaterialButton android:id="@+id/feedRetry" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/ui_feed_retry" />
    </LinearLayout>
  </FrameLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>