<com.example.romear.core.designsystem.HelloCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginHorizontal="24dp" android:layout_marginVertical="10dp"
    app:cardCornerRadius="22dp" app:cardElevation="0dp"
    app:cardBackgroundColor="@color/bg_surface_1" app:strokeColor="@color/border_subtle" app:strokeWidth="1dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <com.example.romear.core.designsystem.ActivityArtworkView android:id="@+id/activityArtwork" android:layout_width="match_parent" android:layout_height="0dp" android:visibility="gone" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/activityBadge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Hello.Eyebrow" />
            <TextView android:id="@+id/poolTime" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="4dp" android:textAppearance="@style/TextAppearance.Hello.Eyebrow" />
        </LinearLayout>
        <TextView android:id="@+id/poolTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textAppearance="@style/TextAppearance.Hello.CardHeadline" />
        <TextView android:id="@+id/distanceBucket" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textAppearance="@style/TextAppearance.Hello.Body" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal" android:gravity="center_vertical">
            <com.example.romear.core.designsystem.AvatarView android:id="@+id/hostAvatar" android:layout_width="48dp" android:layout_height="48dp" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
                <TextView android:id="@+id/hostName" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Hello.CardHeadline" />
                <TextView android:id="@+id/capacityBadge" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textAppearance="@style/TextAppearance.Hello.Caption" />
            </LinearLayout>
        </LinearLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/viewPoolAction" style="@style/Widget.Hello.Button.Tonal" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="8dp" android:insetTop="0dp" android:insetBottom="0dp" android:text="Join Hangout →" app:backgroundTint="@color/bg_surface_pill" app:cornerRadius="999dp" />
    </LinearLayout>
</com.example.romear.core.designsystem.HelloCardView>
