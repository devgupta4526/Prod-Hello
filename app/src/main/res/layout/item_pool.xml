<com.example.romear.core.designsystem.HelloCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="@dimen/card_gutter" android:layout_marginVertical="8dp" app:cardElevation="2dp" app:strokeColor="@color/hello_outline_subtle" app:strokeWidth="1dp">
